# ============================================================
# Supabase 环境变量配置
# 将以下值替换为你的 Supabase 项目真实信息后，重命名为 .env.local
# ============================================================

# Supabase 项目 URL（公开，客户端可访问）
NEXT_PUBLIC_SUPABASE_URL=你的Supabase项目URL

# Supabase ANON PUBLIC KEY（公开，客户端可访问）
NEXT_PUBLIC_SUPABASE_ANON_KEY=你的Supabase_ANON_PUBLIC_KEY

# 后台管理员密码（仅服务端使用，切勿以 NEXT_PUBLIC_ 开头暴露！）
ADMIN_PASSWORD=你的后台管理员密码
